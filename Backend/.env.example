# Postgres connection string. Locally this matches compose.yaml; on Railway use
# the Postgres service's DATABASE_URL reference (see DEPLOY.md).
DATABASE_URL=postgresql://ntsa:ntsa_local@localhost:5432/ntsa?schema=public
# Railway injects its own PORT -- leave this unset there so the app binds to it.
PORT=4000
NODE_ENV=development
# Comma-separated list of exact browser origins allowed to call the API: the
# admin panel and the seller panel. No trailing slash.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# Replace with a random secret of at least 32 characters.
JWT_SECRET=replace-this-with-a-random-32-character-secret
# Explicit local-only demo customer sign-in and simulated payments. Never enable in production.
DEMO_MODE=true
# The first admin account, created/kept by prisma/seed.js. Password must be at
# least 12 characters.
SEED_ADMIN_EMAIL=admin@ntsa.local
SEED_ADMIN_PASSWORD=ChangeThisAdmin123!
# Firebase service account, used to verify the customer app's phone-OTP tokens
# and to send push. Required once DEMO_MODE=false, or customer sign-in fails
# with 503. Firebase console -> Project settings -> Service accounts ->
# Generate new private key; copy the three fields out of that JSON.
# FIREBASE_PRIVATE_KEY is one line with literal \n escapes between the lines.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Cloudinary (cloudinary.com -> Dashboard -> API keys). Required in production:
# without all three, every upload is refused with 503 rather than written to
# local disk, because a Railway container's disk is wiped on each deploy.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Product photos are stamped with assets/watermark.png as they are uploaded.
# Point WATERMARK_FILE at another logo to change it, or set WATERMARK=off to
# store photos unmarked.
WATERMARK=
WATERMARK_FILE=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret the courier (or Shiprocket etc.) sends with every tracking webhook,
# as the x-webhook-secret header. At least 16 characters. Leave it blank and
# POST /api/webhooks/courier stays switched off (404). See HANDOFF.md.
COURIER_WEBHOOK_SECRET=

# Key for the GST-lookup provider used by the admin panel's "Verify from portal"
# button. There is no free GSTN endpoint -- this is a reseller fronting a
# licensed GSP, billed per lookup. Left blank, the button says no provider is
# configured and the manual tick keeps working.
GST_VERIFY_API_KEY=

# Photo search loads a CLIP model that needs ~0.5-1 GB of RAM. It is on by
# default anywhere that is not Render, so on Railway set VISUAL_SEARCH=off
# unless the plan has the memory to spare. on|off, blank = auto.
VISUAL_SEARCH=
# Set to 0 to skip indexing the catalog at boot (photo search then warms up on
# its first use instead). Only matters when VISUAL_SEARCH is on.
VISUAL_SEARCH_WARMUP=
# Render-only self-ping that kept the free instance awake; it reads Render's own
# RENDER_EXTERNAL_URL, so on Railway it never runs and this can stay unset.
KEEP_ALIVE=
