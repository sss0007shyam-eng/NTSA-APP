<?xml version="1.0" encoding="utf-8"?>
<!--
  Release builds talk HTTPS only. Debug builds override this file with a
  permissive one (src/debug/res/xml/) so a test phone can reach the dev
  machine's backend over plain HTTP on the local network.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false"/>
</network-security-config>
